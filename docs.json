{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Pictify",
  "logo": {
    "dark": "/images/logo-dark.svg",
    "light": "/images/logo-light.svg"
  },
  "favicon": "/images/favicon.svg",
  "colors": {
    "primary": "#ff6b6b",
    "light": "#ffc480",
    "dark": "#1f2937"
  },
  "font": {
    "headings": {
      "family": "DynaPuff",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "modeToggle": {
    "default": "light",
    "isHidden": false
  },
  "background": {
    "style": "gradient"
  },
  "topbarLinks": [
    {
      "name": "Dashboard",
      "url": "https://app.pictify.io"
    }
  ],
  "topbarCtaButton": {
    "name": "Get API Key",
    "url": "https://app.pictify.io/signup"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/templates",
              "concepts/expressions",
              "concepts/rendering",
              "concepts/webhooks",
              "concepts/experiments"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/webhook-verification",
              "security/api-keys",
              "security/ssrf-protection"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "resources/changelog",
              "resources/troubleshooting",
              "resources/glossary"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview",
              "api-reference/errors"
            ]
          },
          {
            "group": "Images",
            "pages": [
              "api-reference/generation/images",
              "api-reference/endpoints/images/generate",
              "api-reference/endpoints/images/list",
              "api-reference/endpoints/images/get",
              "api-reference/endpoints/images/canvas"
            ]
          },
          {
            "group": "GIFs",
            "pages": [
              "api-reference/generation/gifs",
              "api-reference/endpoints/gifs/create",
              "api-reference/endpoints/gifs/list",
              "api-reference/endpoints/gifs/get",
              "api-reference/endpoints/gifs/capture"
            ]
          },
          {
            "group": "PDFs",
            "pages": [
              "api-reference/generation/pdfs",
              "api-reference/endpoints/pdfs/render",
              "api-reference/endpoints/pdfs/multi-page",
              "api-reference/endpoints/pdfs/presets"
            ]
          },
          {
            "group": "Templates",
            "pages": [
              "api-reference/templates",
              "api-reference/endpoints/templates/list",
              "api-reference/endpoints/templates/create",
              "api-reference/endpoints/templates/get",
              "api-reference/endpoints/templates/update",
              "api-reference/endpoints/templates/delete",
              "api-reference/endpoints/templates/render",
              "api-reference/endpoints/templates/variables"
            ]
          },
          {
            "group": "Batch",
            "pages": [
              "api-reference/batch",
              "api-reference/endpoints/batch/render",
              "api-reference/endpoints/batch/results",
              "api-reference/endpoints/batch/cancel"
            ]
          },
          {
            "group": "Video",
            "pages": [
              "api-reference/video"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "api-reference/workflows"
            ]
          },
          {
            "group": "Experiments",
            "pages": [
              "api-reference/experiments",
              "api-reference/endpoints/experiments/list",
              "api-reference/endpoints/experiments/create",
              "api-reference/endpoints/experiments/get",
              "api-reference/endpoints/experiments/update",
              "api-reference/endpoints/experiments/delete",
              "api-reference/endpoints/experiments/start",
              "api-reference/endpoints/experiments/pause",
              "api-reference/endpoints/experiments/complete",
              "api-reference/endpoints/experiments/quota",
              "api-reference/endpoints/experiments/events",
              "api-reference/endpoints/experiments/click",
              "api-reference/endpoints/experiments/pixel"
            ]
          },
          {
            "group": "Webhooks",
            "pages": [
              "api-reference/webhooks",
              "api-reference/endpoints/webhooks/list",
              "api-reference/endpoints/webhooks/create",
              "api-reference/endpoints/webhooks/get",
              "api-reference/endpoints/webhooks/update",
              "api-reference/endpoints/webhooks/delete"
            ]
          },
          {
            "group": "Bindings",
            "pages": [
              "api-reference/bindings",
              "api-reference/endpoints/bindings/list",
              "api-reference/endpoints/bindings/create",
              "api-reference/endpoints/bindings/get",
              "api-reference/endpoints/bindings/update",
              "api-reference/endpoints/bindings/delete"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "groups": [
          {
            "group": "Official SDKs",
            "pages": [
              "sdks/nodejs",
              "sdks/python",
              "sdks/go",
              "sdks/ruby"
            ]
          },
          {
            "group": "No-Code & Automation",
            "pages": [
              "integrations/n8n"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/templates",
              "dashboard/api-keys",
              "dashboard/usage"
            ]
          },
          {
            "group": "Tutorials",
            "pages": [
              "guides/batch-processing",
              "guides/webhook-integration",
              "guides/ab-testing"
            ]
          },
          {
            "group": "AI Integration",
            "pages": [
              "agent-integration/mcp-server",
              "agent-integration/tool-schemas"
            ]
          }
        ]
      }
    ],
    "anchors": [
      {
        "anchor": "API Status",
        "href": "https://status.pictify.io",
        "icon": "signal"
      },
      {
        "anchor": "Changelog",
        "href": "/resources/changelog",
        "icon": "clock-rotate-left"
      },
      {
        "anchor": "GitHub",
        "href": "https://github.com/pictify-io",
        "icon": "github"
      }
    ]
  },
  "api": {
    "baseUrl": "https://api.pictify.io",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python",
        "go",
        "ruby"
      ]
    },
    "mdx": {
      "auth": {
        "method": "bearer"
      }
    }
  },
  "openapi": [
    "openapi/v1.yaml"
  ],
  "feedback": {
    "thumbsRating": true,
    "suggestEdit": true
  },
  "footerSocials": {
    "twitter": "https://twitter.com/pictifyio",
    "github": "https://github.com/pictify-io"
  },
  "analytics": {
    "posthog": {
      "apiKey": ""
    }
  },
  "seo": {
    "indexHiddenPages": false
  },
  "metadata": {
    "og:site_name": "Pictify Documentation",
    "og:image": "https://pictify.io/og-image.png",
    "twitter:site": "@pictifyio"
  }
}